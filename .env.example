# Docker Compose configuration. Copy to .env next to docker-compose.yml.
# Only needed for the "full" profile or to change ports/passwords; the defaults work for local development.

POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian_dev_password
POSTGRES_DB=meridian
POSTGRES_PORT=5440
REDIS_PORT=6390

# Required for `docker compose --profile full up` (the API refuses to boot without them).
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

API_PORT=4000
ADMIN_PORT=5180
PUBLIC_API_URL=http://localhost:4000
ADMIN_ORIGIN=http://localhost:5180

# Media: "local" keeps files in a Docker volume; "s3" uses the S3_* settings below.
STORAGE_DRIVER=local
S3_BUCKET=meridian-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=meridian
S3_SECRET_ACCESS_KEY=meridian_dev_secret
S3_PORT=9100
