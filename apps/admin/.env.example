# Admin frontend configuration. Copy to apps/admin/.env.local to override.
# Base URL of the Meridian API, without a trailing slash.
VITE_API_URL=http://localhost:4000

# Set to true to build a server-less demo (for static hosting such as GitHub Pages).
# The app then opens straight in guest mode: every screen runs against demo data that
# lives in the visitor's browser, and VITE_API_URL is never contacted.
VITE_DEMO_ONLY=false
