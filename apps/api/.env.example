# Meridian API configuration. Copy to apps/api/.env and adjust.
# The server validates every value on boot and refuses to start if something is missing or malformed.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=loopback            # Express "trust proxy" value; set to your proxy hops/CIDR behind a load balancer

# ── Data stores ────────────────────────────────────────────────────────────
# Matches docker-compose.yml (Postgres on host port 5440, Redis on 6390).
DATABASE_URL=postgresql://meridian:meridian_dev_password@localhost:5440/meridian?schema=public
REDIS_URL=redis://localhost:6390/0

# ── Secrets (generate your own; never reuse these placeholders) ────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   → 64 hex characters
ENCRYPTION_KEY=replace-with-64-hex-characters

# ── URLs ───────────────────────────────────────────────────────────────────
ADMIN_ORIGIN=http://localhost:5180      # comma-separated origins allowed to use the management API
PUBLIC_API_URL=http://localhost:4000    # public base URL of this API (used in media and preview URLs)

# ── Authentication ─────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_REGISTRATION=true                 # set false once your organization exists to make sign-up invite-only
AUTH_RATE_LIMIT_PER_MINUTE=20           # per IP, for login / register / invitation endpoints

# ── Media storage ──────────────────────────────────────────────────────────
STORAGE_DRIVER=local                    # local | s3
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=50
# S3-compatible storage (AWS S3, Cloudflare R2, …). Required when STORAGE_DRIVER=s3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=meridian-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false             # true for the local S3 container and most self-hosted stores
# MEDIA_CDN_URL=https://media.example.com   # optional CDN in front of /media

# ── Delivery API ───────────────────────────────────────────────────────────
DELIVERY_CACHE_TTL_SECONDS=60           # Redis response cache; invalidated instantly on publish. 0 disables it.

# ── Webhooks and scheduling ────────────────────────────────────────────────
WEBHOOK_ALLOW_PRIVATE_URLS=true         # development only: lets webhooks target localhost. Keep false in production.
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_BACKOFF_MS=5000                 # base delay; attempts back off exponentially
SCHEDULER_INTERVAL_MS=15000             # how often scheduled publishes and releases are checked

# ── Demo data (npm run db:seed) ────────────────────────────────────────────
SEED_EMAIL=demo@meridian.local
SEED_PASSWORD=meridian-demo-2026
