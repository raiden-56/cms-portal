{
  "name": "@meridian/api",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian API — management API, content delivery API, GraphQL, webhooks and background workers",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@meridian/shared": "*",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "pino": "^9.14.0",
    "prisma": "^6.19.3",
    "sharp": "^0.34.0",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.3.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
